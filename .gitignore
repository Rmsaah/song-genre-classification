# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

.gitattributes

# ~~~~~~~~~~~~~~~~ Project ~~~~~~~~~~~~~~~~ #

# Datasets - far too large for git (song_lyrics.csv alone is 9 GB).
# Download from the Kaggle link in README.md; data/stopwords/ IS tracked.
data/*
!data/stopwords/
!data/stopwords/**

# Oversized training artifacts. Kept locally, deliberately NOT deployed:
#
#   random_forest_model.pkl       720 MB - over GitHub's 100 MB file limit, so
#                                 it cannot be deployed at all. It was also the
#                                 weakest of the three models (66% vs 68%), so
#                                 the Streamlit app ships LightGBM + XGBoost.
#   word2vec_model.model[.npy]    190 MB - the full training model. The app
#                                 loads models/word2vec.kv instead, which holds
#                                 only the 8000 vectors the TF-IDF vocabulary
#                                 can reach (7.8 MB, identical predictions).
#
# Keep these files around if you ever want to retrain or rebuild word2vec.kv.
models/random_forest_model.pkl
models/word2vec_model.model
models/word2vec_model.model.*.npy

# IDE
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/
